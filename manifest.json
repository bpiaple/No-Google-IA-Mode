{
   "action": {
      "default_icon": {
         "128": "icons/icon128.png",
         "16": "icons/icon16.png",
         "48": "icons/icon48.png"
      },
      "default_popup": "popup.html"
   },
   "background": {
      "service_worker": "background.js",
      "type": "module"
   },
   "content_scripts": [ {
      "js": [ "content.js" ],
      "matches": [ "\u003Call_urls>" ],
      "run_at": "document_start"
   } ],
   "default_locale": "fr",
   "description": "Extension de la Ville de Rimouski pour supprimer le mode IA de Google dans le moteur de recherche.",
   "homepage_url": "https://www.rimouski.ca",
   "host_permissions": [],
   "icons": {
      "128": "icons/icon128.png",
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "Ville de Rimouski / Pas de Mode IA Google",
   "permissions": [ "storage", "activeTab", "scripting", "tabs" ],
   "version": "1.0.7",
   "web_accessible_resources": [ {
      "matches": [ "\u003Call_urls>" ],
      "resources": [ "icons/*", "site-policy.json" ]
   } ]
}
